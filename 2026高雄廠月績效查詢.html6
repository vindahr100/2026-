<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>月績效查詢｜台灣維達 VINDA TAIWAN</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --navy: #0f2c52; --navy-2: #1a3d6b; --navy-3: #24528c;
  --gold: #c9a961; --gold-2: #e6c987;
  --bg: #f4f6fb; --card: #ffffff;
  --text: #1a2740; --sub: #64748b; --line: #e2e8f0;
  --err: #dc2626; --ok: #059669; --warn: #d97706;
  --s1: #dc2626; --s2: #ea580c; --s3: #64748b; --s4: #059669; --s5: #c9a961;
}
html, body { font-family: -apple-system, "Segoe UI", "Microsoft JhengHei", "PingFang TC", "Noto Sans TC", sans-serif; background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; line-height: 1.55; }
body { min-height: 100vh; }
.login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px; background: linear-gradient(135deg, var(--navy) 0%, var(--navy-3) 100%); }
.login-card { background: #fff; width: 100%; max-width: 460px; border-radius: 12px; box-shadow: 0 12px 40px rgba(15,44,82,.25); overflow: hidden; border-top: 4px solid var(--gold); }
.brand { padding: 26px 28px 18px; text-align: center; border-bottom: 1px solid var(--line); }
.brand .logo { font-size: 12px; letter-spacing: 4px; color: var(--gold); font-weight: 700; }
.brand h1 { font-size: 20px; color: var(--navy); margin-top: 6px; letter-spacing: 1px; }
.brand .sub { font-size: 12px; color: var(--sub); margin-top: 4px; }
.login-body { padding: 24px 28px 20px; }
.login-body h2 { font-size: 16px; color: var(--navy); margin-bottom: 4px; }
.login-body .hint { font-size: 12px; color: var(--sub); margin-bottom: 16px; line-height: 1.6; }
.field { margin-bottom: 14px; }
.field label { display: block; font-size: 12px; color: var(--sub); margin-bottom: 6px; font-weight: 600; }
.field input { width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 15px; outline: none; transition: all .15s; background: #fafbfc; font-family: inherit; }
.field input:focus { border-color: var(--navy-3); background: #fff; box-shadow: 0 0 0 3px rgba(36,82,140,.12); }
.btn { width: 100%; padding: 12px; background: var(--navy); color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; letter-spacing: 1px; transition: all .15s; }
.btn:hover { background: var(--navy-2); }
.btn:disabled { opacity: .6; cursor: wait; }
.msg { padding: 10px 12px; border-radius: 8px; font-size: 13px; margin-bottom: 14px; display: none; }
.msg.err { background: #fef2f2; color: var(--err); border: 1px solid #fecaca; display: block; }
.info-box { margin-top: 18px; padding: 14px; background: #f8fafc; border-radius: 8px; border-left: 3px solid var(--gold); font-size: 12px; color: var(--sub); line-height: 1.7; }
.info-box strong { color: var(--navy); }

.app-wrap { max-width: 1200px; margin: 0 auto; padding: 20px 16px 80px; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--navy); color: #fff; border-radius: 10px; margin-bottom: 8px; box-shadow: 0 4px 14px rgba(15,44,82,.15); flex-wrap: wrap; gap:10px; }
.topbar .t-brand { display: flex; flex-direction: column; }
.topbar .t-brand .l1 { font-size: 11px; letter-spacing: 3px; color: var(--gold); font-weight: 600; }
.topbar .t-brand .l2 { font-size: 15px; margin-top: 2px; font-weight: 600; }
.topbar .t-user { display: flex; align-items: center; gap: 12px; font-size: 12px; }
.topbar .badge { background: var(--gold); color: var(--navy); padding: 3px 10px; border-radius: 20px; font-weight: 700; font-size: 11px; letter-spacing: 1px; }
.topbar .logout { color: #fff; opacity: .8; text-decoration: underline; cursor: pointer; font-size: 12px; }
.topbar .logout:hover { opacity: 1; }
.scope-bar { display: flex; align-items:center; gap:10px; padding: 10px 16px; background: #eef2f8; border-radius: 8px; margin-bottom: 16px; font-size: 13px; color: var(--navy); border-left: 3px solid var(--gold); flex-wrap: wrap; }
.scope-bar b { color: var(--navy-2); }
.scope-bar .pill { padding: 2px 10px; background: var(--navy); color: #fff; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing:1px; }

.summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 16px; }
.stat { background: var(--card); padding: 16px; border-radius: 10px; box-shadow: 0 2px 8px rgba(15,44,82,.06); border-top: 3px solid var(--navy-3); }
.stat .lab { font-size: 11px; color: var(--sub); letter-spacing: 1px; font-weight: 600; }
.stat .val { font-size: 26px; color: var(--navy); font-weight: 700; margin-top: 4px; }
.stat .val small { font-size: 12px; color: var(--sub); font-weight: 400; margin-left: 4px; }
.stat.gold { border-top-color: var(--gold); }

.score-bar { background: var(--card); padding: 14px 18px; border-radius: 10px; box-shadow: 0 2px 8px rgba(15,44,82,.06); margin-bottom: 16px; }
.score-bar h3 { font-size: 13px; color: var(--navy); margin-bottom: 10px; letter-spacing: 1px; font-weight: 700; }
.score-row { display: flex; gap: 8px; flex-wrap: wrap; }
.score-pill { padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
.score-pill .dot { width: 10px; height: 10px; border-radius: 50%; }
.score-pill.s1 { background: #fef2f2; color: var(--s1); } .score-pill.s1 .dot { background: var(--s1); }
.score-pill.s2 { background: #fff7ed; color: var(--s2); } .score-pill.s2 .dot { background: var(--s2); }
.score-pill.s3 { background: #f1f5f9; color: var(--s3); } .score-pill.s3 .dot { background: var(--s3); }
.score-pill.s4 { background: #ecfdf5; color: var(--s4); } .score-pill.s4 .dot { background: var(--s4); }
.score-pill.s5 { background: #fef9e7; color: #a17d33; } .score-pill.s5 .dot { background: var(--s5); }

.filters { background: var(--card); padding: 14px 16px; border-radius: 10px; box-shadow: 0 2px 8px rgba(15,44,82,.06); margin-bottom: 16px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 10px; }
.filters input, .filters select { padding: 9px 11px; border: 1px solid var(--line); border-radius: 6px; font-size: 13px; background: #fafbfc; outline: none; font-family: inherit; }
.filters input:focus, .filters select:focus { border-color: var(--navy-3); background: #fff; }

.list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; padding: 0 4px; }
.list-head .count { font-size: 13px; color: var(--sub); }
.list-head .count strong { color: var(--navy); font-size: 15px; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.card { background: var(--card); padding: 14px 16px; border-radius: 10px; box-shadow: 0 2px 8px rgba(15,44,82,.06); cursor: pointer; transition: all .15s; border-left: 3px solid transparent; }
.card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(15,44,82,.12); border-left-color: var(--gold); }
.card .row-1 { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.card .name { font-size: 16px; font-weight: 700; color: var(--navy); }
.card .id { font-size: 11px; color: var(--sub); font-family: "SF Mono","Consolas",monospace; }
.card .dept { font-size: 12px; color: var(--sub); margin-bottom: 10px; }
.card .dept .tag { display: inline-block; padding: 2px 7px; background: #eef2f8; border-radius: 4px; margin-right: 4px; font-size: 11px; color: var(--navy-3); }
.mini-scores { display: flex; gap: 3px; flex-wrap: wrap; }
.mini-scores .mini { display: inline-flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; width: 24px; height: 24px; border-radius: 4px; color: #fff; }
.mini.m0 { background: #cbd5e1; color: #64748b; }
.mini.m1 { background: var(--s1); } .mini.m2 { background: var(--s2); }
.mini.m3 { background: var(--s3); } .mini.m4 { background: var(--s4); } .mini.m5 { background: var(--s5); }

.modal-wrap { position: fixed; inset: 0; background: rgba(15,44,82,.5); display: none; align-items: center; justify-content: center; padding: 20px; z-index: 100; }
.modal-wrap.on { display: flex; }
.modal { background: #fff; border-radius: 12px; max-width: 720px; width: 100%; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column; }
.modal .m-head { padding: 18px 22px; background: var(--navy); color: #fff; display: flex; justify-content: space-between; align-items: center; }
.modal .m-head .name { font-size: 20px; font-weight: 700; }
.modal .m-head .id { font-size: 12px; opacity: .8; margin-top: 3px; font-family: "SF Mono","Consolas",monospace; }
.modal .m-head .close { cursor: pointer; font-size: 24px; opacity: .8; }
.modal .m-head .close:hover { opacity: 1; }
.modal .m-body { padding: 20px 22px; overflow-y: auto; }
.modal .m-info { padding: 10px 14px; background: #f8fafc; border-radius: 8px; font-size: 13px; margin-bottom: 16px; color: var(--sub); }
.modal .m-info b { color: var(--navy); }
.month-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.month-table th { text-align: left; padding: 10px; background: #f1f5f9; color: var(--sub); font-size: 11px; letter-spacing: 1px; font-weight: 700; border-bottom: 1px solid var(--line); }
.month-table td { padding: 12px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
.month-table td.mon { font-weight: 700; color: var(--navy); font-family: "SF Mono","Consolas",monospace; white-space: nowrap; }
.month-table td.sc { text-align: center; }
.score-tag { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 6px; font-weight: 700; color: #fff; font-size: 13px; }
.score-tag.m0 { background: #cbd5e1; color: #64748b; font-size: 11px; }
.score-tag.m1 { background: var(--s1); } .score-tag.m2 { background: var(--s2); }
.score-tag.m3 { background: var(--s3); } .score-tag.m4 { background: var(--s4); } .score-tag.m5 { background: var(--s5); }
.month-table td.cm { font-size: 12px; color: var(--text); line-height: 1.5; }
.month-table td.cm.empty { color: var(--sub); font-style: italic; opacity: .6; }

.footer { text-align: center; padding: 20px; font-size: 11px; color: var(--sub); border-top: 1px solid var(--line); margin-top: 32px; letter-spacing: 1px; }

@media (max-width: 640px) {
  .filters { grid-template-columns: 1fr 1fr; }
  .summary { grid-template-columns: 1fr 1fr; }
  .grid { grid-template-columns: 1fr; }
  .app-wrap { padding: 12px 10px 60px; }
  .topbar { padding: 12px 14px; }
  .topbar .t-brand .l2 { font-size: 13px; }
}
</style>
</head>
<body>

<div id="loginView" class="login-wrap">
  <div class="login-card">
    <div class="brand">
      <div class="logo">VINDA TAIWAN</div>
      <h1>台灣維達 · 月績效查詢</h1>
      <div class="sub">Monthly Performance Query</div>
    </div>
    <div class="login-body">
      <h2>登入</h2>
      <p class="hint">請以 <strong>工號</strong> 與 <strong>身分證字號</strong> 登入。<br>資料以 AES-256-GCM 端到端加密，僅授權帳號可解密可見範圍內資料。</p>
      <div id="msg" class="msg"></div>
      <div class="field">
        <label>工號</label>
        <input id="empId" type="text" autocomplete="off" placeholder="例：141567" autocapitalize="off">
      </div>
      <div class="field">
        <label>身分證字號</label>
        <input id="idCard" type="password" autocomplete="off" placeholder="英文字母不分大小寫" autocapitalize="off">
      </div>
      <button class="btn" id="btnLogin">登入</button>
      <div class="info-box">
        <strong>權限說明</strong><br>
        HR 可查看全廠所有員工。各部門/組主管僅可查看被授權之組別範圍。<br>
        <strong>安全提示</strong>：本頁不會保存或傳輸您的登入資訊。
      </div>
    </div>
  </div>
</div>

<div id="appView" style="display:none">
<div class="app-wrap">
  <div class="topbar">
    <div class="t-brand">
      <div class="l1">VINDA TAIWAN · HR</div>
      <div class="l2">月績效查詢平台</div>
    </div>
    <div class="t-user">
      <span id="userLabel">—</span>
      <span class="badge" id="userRole">HR</span>
      <span class="logout" onclick="logout()">登出</span>
    </div>
  </div>

  <div class="scope-bar">
    <span class="pill">可見範圍</span>
    <span id="scopeText"><b>—</b></span>
    <span>·</span>
    <span>可見員工 <b id="scopeCount">0</b> 人</span>
  </div>

  <div class="summary" id="summary"></div>
  <div class="score-bar">
    <h3>分數分布（跨月次數統計）</h3>
    <div class="score-row" id="scoreDist"></div>
  </div>
  <div class="filters">
    <input id="fSearch" type="text" placeholder="搜尋姓名或工號">
    <select id="fDept"><option value="">全部部門</option></select>
    <select id="fMonth"><option value="">全部月份（近7個月）</option></select>
    <select id="fScore"><option value="">全部分數</option><option value="1">1 分</option><option value="2">2 分</option><option value="3">3 分</option><option value="4">4 分</option><option value="5">5 分</option></select>
  </div>
  <div class="list-head">
    <div class="count">顯示 <strong id="cShow">0</strong> / 共 <span id="cTotal">0</span> 人</div>
  </div>
  <div class="grid" id="grid"></div>

  <div class="footer">
    本查詢頁由人力資源部提供；如有疑問請洽 HR · 資料版本 20260812-4
  </div>
</div>
</div>

<div class="modal-wrap" id="modalWrap" onclick="if(event.target===this) closeModal()">
  <div class="modal">
    <div class="m-head">
      <div>
        <div class="name" id="mName">—</div>
        <div class="id" id="mMeta">—</div>
      </div>
      <span class="close" onclick="closeModal()">×</span>
    </div>
    <div class="m-body">
      <div class="m-info" id="mInfo">—</div>
      <table class="month-table">
        <thead><tr><th style="width:80px">月份</th><th style="width:60px">分數</th><th>備註</th></tr></thead>
        <tbody id="mRows"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
